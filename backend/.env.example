# Copy to .env and adjust. All values have safe defaults (see config.py).
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=480

ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Network loaded into a new, empty database:
# example (22 devices) | small (R1, SW1, PC1, PC2) | none
DEMO_NETWORK=example

# SQLite by default; override for another DB.
# DATABASE_URL=sqlite:///./database/network.db

# Smart auto-configuration IP pool + first VLAN id
IP_POOL_BASE=10.10.0.0/16
VLAN_ID_START=10

# SSH / deployment
SSH_TIMEOUT=20
DEPLOY_DRY_RUN=false

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
